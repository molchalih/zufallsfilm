{
  "name": "letterboxd-picker",
  "version": "1.0.0",
  "private": true,
  "description": "An HTTP API and web interface that return a random film from a public Letterboxd watchlist, optionally filtered by runtime.",
  "license": "MIT",
  "author": "molchalih",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molchalih/zufallsfilm.git"
  },
  "homepage": "https://github.com/molchalih/zufallsfilm",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/index.ts",
    "start": "bun run src/index.ts",
    "house": "bun run scripts/build-house-pool.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "bundle": "bun build index.html --outdir .bundle-check --minify",
    "format": "biome check --write",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run bundle && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
