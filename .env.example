PORT=3000
DB_PATH=/data/picker.sqlite
MAX_WATCHLIST=6000
RATE_PER_MIN=20
RATE_BURST=10
DISTINCT_USERS_PER_WINDOW=15
FILM_CAP=200000

# EGRESS_PROXY is set by docker-compose.yml, which overrides this file. Leave
# it unset here: Bun auto-loads .env, so a proxy host that only resolves inside
# the compose network would break `bun test` and `bun run src/index.ts` locally.
# Must be http:// when set — Bun's fetch cannot use SOCKS proxies.
# EGRESS_PROXY=http://proxy:3128
