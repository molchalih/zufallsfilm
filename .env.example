PORT=3000
DB_PATH=/data/picker.sqlite
MAX_WATCHLIST=6000
# How long a read watchlist is served before it is read again. Applies to both
# sources.
SCRAPE_TTL_MS=604800000
RATE_PER_MIN=20
RATE_BURST=10
DISTINCT_USERS_PER_WINDOW=15
FILM_CAP=200000
GLOBAL_REQ_PER_SEC=8

# Where watchlists are read from: "html" (the default) fetches the member's
# public watchlist pages; "api" reads the official Letterboxd API instead and
# needs the two credentials below. Leave it unset and the credentials decide:
# both present selects "api", otherwise "html". Forcing "api" without them
# refuses to start.
# WATCHLIST_SOURCE=api

# Issued by Letterboxd with API access. Supplying both selects the API path on
# its own; one without the other selects nothing.
# LETTERBOXD_API_KEY=
# LETTERBOXD_API_SECRET=
# API_REQ_PER_SEC=8

# Take the caller's address from the first entry of X-Forwarded-For. Off by
# default, and it must stay off unless a reverse proxy you control sets that
# header: exposed directly, the header is caller-supplied, and trusting it
# hands every caller a fresh rate-limit bucket per request.
# TRUST_PROXY=true

# An outbound HTTP proxy for requests to letterboxd.com. Some hosts are refused
# by the origin, so a deployment on one of them needs an egress that is not.
# Must be http:// — Bun's fetch cannot use SOCKS proxies. Bun auto-loads .env,
# so a proxy host that only resolves inside the deployment network would break
# `bun test` and `bun run src/index.ts` locally; leave it unset for those.
# Read only by WATCHLIST_SOURCE=html; the API path issues no request to
# letterboxd.com.
# EGRESS_PROXY=http://proxy:3128
